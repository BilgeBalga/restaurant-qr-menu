# Table-Side — environment variables (architecture §33)
# Copy to .env.local and fill in with real values. Never commit .env.local.

# --- Public (safe for the browser; RLS governs what the anon key can actually do) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only. NEVER import these into a "use client" component. ---
# Bypasses RLS entirely — used only inside the create_order / set_order_status
# RPC-calling server actions (§26). Do not use it anywhere a normal
# authenticated-user session would do.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string, used by drizzle-kit for migrations only.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Optional — error reporting (§28). Leave blank until wired up.
SENTRY_DSN=
